# Helmfile configuration
# Documentation: https://helmfile.readthedocs.io/

# Environment-specific values
# Usage: helmfile -e <environment> apply
environments:
  default:
    values:
      - externalUrl: "localhost"
        certIssuer: self-signed
        gatewayHostNetwork: true
  production:
    values:
      - externalUrl: dislogi.net
        certIssuer: acme-prod
        gatewayHostNetwork: false
---
# Common Helm defaults applied to all releases
helmDefaults:
  createNamespace: true
  wait: true
  timeout: 300

apiVersions:
  - monitoring.coreos.com/v1

# Helm chart repositories
repositories:
  - name: cilium
    url: quay.io/cilium/charts
    oci: true
  - name: prometheus-community
    url: ghcr.io/prometheus-community/charts
    oci: true
  - name: metrics-server
    url: https://kubernetes-sigs.github.io/metrics-server
  - name: cert-manager
    url: quay.io/jetstack/charts
    oci: true
  - name: cloudnative-pg
    url: ghcr.io/cloudnative-pg/charts
    oci: true
  - name: headlamp
    url: https://kubernetes-sigs.github.io/headlamp
  - name: rook-ceph
    url: https://charts.rook.io/release

# Helm releases
releases:
  - name: monitoring-namespace
    createNamespace: false
    chart: ./charts/monitoring-namespace

  - name: prometheus-crds
    chart: prometheus-community/prometheus-operator-crds
    namespace: monitoring
    createNamespace: false
    version: "32.0.2"
    needs:
      - /monitoring-namespace

  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: false
    chart: prometheus-community/kube-prometheus-stack
    version: 92.17.1
    disableValidation: true
    needs:
      - monitoring/prometheus-crds

  - name: metrics-server
    namespace: monitoring
    createNamespace: false
    chart: metrics-server/metrics-server
    version: 3.14.0
    needs:
      - monitoring/prometheus-crds
    values:
      - args:
          - --kubelet-insecure-tls
        metrics:
          enabled: true
        serviceMonitor:
          enabled: true

  - name: cilium
    chart: cilium/cilium
    namespace: kube-system
    version: 1.20.4
    values:
      - ipam:
          mode: kubernetes
        kubeProxyReplacement: true
        k8sServiceHost: localhost
        k8sServicePort: 7445
        gatewayAPI:
          enabled: true
          enableAppProtocol: true
          enableAlpn: true
          hostNetwork:
            enabled: {{.Values.gatewayHostNetwork}}
        securityContext:
          capabilities:
            ciliumAgent:
              - CHOWN
              - KILL
              - NET_ADMIN
              - NET_RAW
              - IPC_LOCK
              - SYS_ADMIN
              - SYS_RESOURCE
              - DAC_OVERRIDE
              - FOWNER
              - SETGID
              - SETUID
            cleanCiliumState:
              - NET_ADMIN
              - SYS_ADMIN
              - SYS_RESOURCE

  - name: cert-manager
    namespace: cert-manager
    chart: cert-manager/cert-manager
    version: v1.21.3
    timeout: 600
    needs:
      - monitoring/prometheus-crds
    values:
      - crds:
          enabled: true
        config:
          featureGates:
            ServerSideApply: true
        prometheus:
          servicemonitor:
            enabled: true

  - name: gateway
    namespace: kube-system
    chart: ./charts/gateway
    needs:
      - kube-system/cilium
      - cert-manager/cert-manager

  - name: cnpg
    namespace: cnpg-system
    chart: cloudnative-pg/cloudnative-pg
    version: 0.29.1
    needs:
      - monitoring/prometheus-crds
    values:
      - cluster:
          instances: 2
          monitoring:
            enabled: true

  - name: cnpg-plugin-barman-cloud
    namespace: cnpg-system
    chart: cloudnative-pg/plugin-barman-cloud
    version: 0.8.1
    needs:
      - cnpg-system/cnpg
      - cert-manager/cert-manager

  - name: headlamp
    namespace: headlamp
    chart: headlamp/headlamp
    version: 0.46.0
    needs:
      - monitoring/kube-prometheus-stack
    values:
      - config:
          enableHelm: true
          watchPlugins: true
          extraArgs:
            - -otlp-endpoint=''
        pluginsManager:
          enabled: true
          configContent: |
            installOptions:
              parallel: true
              maxConcurrent: 2
            plugins:
              - name: cert-manager
                source: https://artifacthub.io/packages/headlamp/headlamp-plugins/headlamp_cert-manager
                version: 0.1.1
              - name: kompose
                source: https://artifacthub.io/packages/headlamp/headlamp-plugins/headlamp_kompose
                version: 0.1.1-beta
              - name: monitoring
                source: https://artifacthub.io/packages/headlamp/batuhancikrikci-headlamp-plugins/monitoring
                version: 0.3.0
              - name: cnpg
                source: https://artifacthub.io/packages/headlamp/cnpg-headlamp-plugin/cnpg-headlamp-plugin
                version: 0.1.6
              - name: cilium
                source: https://artifacthub.io/packages/headlamp/batuhancikrikci-headlamp-plugins/cilium
                version: 0.1.0
              - name: rook
                source: https://artifacthub.io/packages/headlamp/headlamp-rook/headlamp-rook-plugin
                version: 1.0.2
        httpRoute:
          enabled: true
          hostnames:
            - headlamp.dislogi.net
            - headlamp.localhost
          parentRefs:
            - namespace: kube-system
              name: gateway

  # - name: rook-ceph-operator
  #   namespace: rook-ceph
  #   chart: rook-ceph/rook-ceph
