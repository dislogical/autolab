{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "replacements:all", ":automergeMinor", ":automergeDigest"],
  "packageRules": [
    {
      "groupName": "pre-commit hooks",
      "groupSlug": "pre-commit",
      "matchPackageNames": ["renovatebot/pre-commit-hooks"],
      "extends": ["schedule:earlyMondays"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.yaml$/"],
      "matchStrings": [
        "https:\\/\\/github\\.com\\/(?<packageName>[^\\/]*\\/(?<depName>[^\\/]*))\\/releases\\/download\\/(?<currentValue>[^\\/]*)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "jsonata",
      "managerFilePatterns": ["/\\.yaml$/"],
      "fileFormat": "yaml",
      "matchStrings": ["spec.talos.{ 'currentValue': version }", "{ 'currentValue': talosVersion }"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/siderolabs/installer",
      "packageNameTemplate": "talos"
    },
    {
      "customType": "jsonata",
      "managerFilePatterns": ["/\\.yaml$/"],
      "fileFormat": "yaml",
      "matchStrings": ["spec.kubernetes.{ 'currentValue': version }", "{ 'currentValue': kubernetesVersion }"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/siderolabs/kubelet",
      "packageNameTemplate": "kubernetes"
    }
  ],
  "flux": {
    "managerFilePatterns": ["/(?:^|/)gotk-components\\.ya?ml$/", "charts/platform/templates/*.yaml"]
  },
  "helm-values": {
    "commitMessageTopic": "helm values image {{depName}}",
    "managerFilePatterns": ["/(^|/)values\\.yaml$/", "/(^|/)helmfile\\.yaml$/"],
    "pinDigests": true
  },
  "pre-commit": {
    "commitMessageTopic": "pre-commit hook {{depName}}",
    "enabled": true,
    "prBodyNotes": [
      "Note: The `pre-commit` manager in Renovate is not supported by the `pre-commit` maintainers or community. Please do not report any problems there, instead [create a Discussion in the Renovate repository](https://github.com/renovatebot/renovate/discussions/new) if you have any questions."
    ]
  }
}
